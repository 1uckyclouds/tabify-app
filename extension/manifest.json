{
  "manifest_version": 3,
  "name": "Tabify - 智能标签页管理器",
  "version": "1.0.0",
  "description": "高效的Chrome浏览器标签页管理插件，提供一键收纳、智能分组、批量操作等功能，显著提升浏览效率和体验。",
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "build/manager.html",
    "default_title": "Tabify - 标签页管理器",
    "default_icon": {
      "16": "build/icons/icon16.png",
      "32": "build/icons/icon32.png",
      "48": "build/icons/icon48.png",
      "128": "build/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "build/background.js"
  },
  "options_page": "build/settings.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: chrome-extension: https: http:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'"
  },
  "icons": {
    "16": "build/icons/icon16.png",
    "32": "build/icons/icon32.png",
    "48": "build/icons/icon48.png",
    "128": "build/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["build/*"],
      "matches": ["<all_urls>"]
    }
  ]
}